end)

-- Função de Teleporte
local function Teleport(pos)
    if HumanoidRootPart then
        HumanoidRootPart.CFrame = CFrame.new(pos)
    end
end

-- Auto Farm (treino)
local function StartAutoFarm()
    spawn(function()
        while AutoFarm do
            pcall(function()
                -- Tenta clicar no botão de treino (método comum)
                local args = {
                    [1] = "Weight"
                }
                ReplicatedStorage.Remotes.Train:FireServer(unpack(args))
                
                -- Alternativa caso o remote seja diferente
                -- ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("Train"):FireServer()
            end)
            wait(0.1)
        end
    end)
end

-- Auto Rebirth
local function StartAutoRebirth()
    spawn(function()
        while AutoRebirth do
            pcall(function()
                ReplicatedStorage.Remotes.Rebirth:FireServer()
            end)
            wait(1)
        end
    end)
end

-- Auto Sell
local function StartAutoSell()
    spawn(function()
        while AutoSell do
            pcall(function()
                ReplicatedStorage.Remotes.Sell:FireServer()
            end)
            wait(2)
        end
    end)
end

-- Kill Aura
local function StartKillAura()
    spawn(function()
        while KillAura do
            pcall(function()
                for _, player in pairs(Players:GetPlayers()) do
                    if player \~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local distance = (HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                        if distance < 20 then
                            -- Tenta atacar (método genérico)
                            ReplicatedStorage.Remotes.Attack:FireServer(player.Character)
                        end
                    end
                end
            end)
            wait(0.2)
        end
    end)
end

-- Speed
local function ToggleSpeed(state)
    if state then
        Humanoid.WalkSpeed = SpeedValue
    else
        Humanoid.WalkSpeed = 16
    end
end

-- Fly
local BodyVelocity
local function ToggleFly(state)
    if state then
        BodyVelocity = Instance.new("BodyVelocity")
        BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        BodyVelocity.Velocity = Vector3.new(0, 0, 0)
        BodyVelocity.Parent = HumanoidRootPart
        
        spawn(function()
            while FlyEnabled and BodyVelocity do
                local cam = workspace.CurrentCamera
                local move = Vector3.new()
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    move = move + cam.CFrame.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                    move = move - cam.CFrame.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                    move = move - cam.CFrame.RightVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                    move = move + cam.CFrame.RightVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    move = move + Vector3.new(0, 1, 0)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                    move = move - Vector3.new(0, 1, 0)
                end
                
                BodyVelocity.Velocity = move * FlySpeed
                wait()
            end
        end)
    else
        if BodyVelocity then
            BodyVelocity:Destroy()
            BodyVelocity = nil
        end
    end
end

-- NoClip
local function ToggleNoClip(state)
    spawn(function()
        while NoClip do
            for _, part in pairs(Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            wait()
        end
        -- Restaura colisão quando desliga
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end)
end

